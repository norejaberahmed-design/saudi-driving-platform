{
  "name": "saudi-driving-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/safety-seed.ts && tsx prisma/research-curriculum-seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "better-auth": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.6.0",
    "@prisma/client": "^6.19.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.5.29",
    "typescript": "^5.8.3",
    "@eslint/eslintrc": "^3.3.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
